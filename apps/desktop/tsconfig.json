{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/native": ["src/native.ts"],
      "@h0/ui": ["ui/src/index.ts"],
      "@h0/transport": ["../ui/js/contexts/api/transport.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "ui/src"]
}
