{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "h0",
  "version": "0.1.0",
  "identifier": "dev.h0.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5470",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "h0",
        "width": 1150,
        "height": 700,
        "minWidth": 720,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 15, "y": 24.75 }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["h0"] } }
  }
}
